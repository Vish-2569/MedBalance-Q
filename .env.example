# ── Gemini (runtime LLM) ──────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=<paste-gemini-api-key>
LLM_MODEL_FAST=gemini-3.8-flash
LLM_MODEL_SMART=gemini-3.8-flash
DEMO_MODE=live

# ── QpiAI Opt (QUBO solver) ───────────────────────────────────────
QPIAI_OPT_URL=<paste-qpiai-opt-api-url>
QPIAI_OPT_TOKEN=<paste-qpiai-opt-token>

# ── QpiAI QCloud (QAOA Max-Cut) ───────────────────────────────────
QPIAI_QCLOUD_API_KEY=<paste-qcloud-api-key>
QPIAI_QCLOUD_BACKEND=QpiAI-QSV-Simulator
QPIAI_TIMEOUT_S=20


# ── App + simulation ──────────────────────────────────────────────
QR_HMAC_SECRET=<any-long-random-string>
SIM_SEED=42
SIM_DAY_SECONDS=30
SIM_START_DATE=2026-11-01
USE_FIXTURES=0

# ── Infrastructure (defaults match docker-compose service names) ──
DATABASE_URL=postgresql+psycopg://medbal:medbal@postgres:5432/medbal
REDIS_URL=redis://redis:6379/0
MQTT_URL=mqtt://mosquitto:1883
SIM_CONTROL_URL=http://sim-control:8100
